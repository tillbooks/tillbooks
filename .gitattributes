# Normalize line endings so the ledger and its fixtures are byte-stable across
# platforms. TILL is a Swiss accounting engine: deterministic files matter.
* text=auto eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.sqlite binary
*.db binary

# Generated lockfiles: keep them out of diffs by default.
package-lock.json linguist-generated=true
app/package-lock.json linguist-generated=true
