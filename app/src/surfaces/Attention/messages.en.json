  "help": {
    "Attention": {
      "title": "Attention",
      "body": "Pendenzen shows everything that waits for a decision from you, complete and in sections: by area (the bank first) or by kind (approve, to do, notes). The section counts add up to the number in the menu.\n\nEvery row has one button for the next step; other options sit under ⋯, and the (i) says why the row waits and what the step does.\n\nYou can select the agent's bank proposals and approve them together. Each runs on its own, as with its own button.",
      "concepts": [],
      "docsPath": "introduction"
    }
