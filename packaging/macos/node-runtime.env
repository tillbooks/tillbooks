# The Node runtime embedded in the release TILL.app (build-release.sh). Sourced by the script.
#
# Pinned, never "latest": a new Node is a reviewed change to this file. The checksums are the ones
# nodejs.org publishes in https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt (that file is
# signed by the Node release keys); the build refuses a download that does not match.
# 22.23.4 (20.10.2026) is the newest Node 22 "Jod" LTS release and a security release.
NODE_VERSION=22.23.4
NODE_SHA256_ARM64=c9e1dbc748b33ed2d14f42445191ecaf14c56259c7a9a26d0042c49ec2b66428
NODE_SHA256_X64=efcc2b0db6f94bf53eddb038fe2b370277a042bd29e4f19b8f8e23598795b819
